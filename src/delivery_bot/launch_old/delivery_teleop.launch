<launch>
    <!-- Rosserial Node for Arduino Communication with Optimized Parameters -->
    <node pkg="rosserial_python" type="serial_node.py" name="serial_node" output="screen">
        <param name="port" value="/dev/ttyACM0" />
        <param name="baud" value="57600" />
        <param name="queue_size" value="10"/>
        <param name="publish_rate" value="50"/>
    </node>

    <!-- Xbox Controller Teleoperation Node -->
    <node pkg="delivery_bot" type="teleop.py" name="joystick_to_cmd_vel" output="screen" />
</launch>
