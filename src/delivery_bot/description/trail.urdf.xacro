<?xml version='1.0'?>

<robot name="trail_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Arguments -->
  <xacro:arg name="use_ros1_control" default="false"/>
  <xacro:arg name="sim_mode" default="false"/>

  <!-- Include Core Components -->
  <xacro:include filename="robot_core.xacro" />

  <!-- Conditional Includes -->
  <xacro:if value="$(arg use_ros1_control)">
    <xacro:include filename="ros1_control.xacro" />
  </xacro:if>

  <xacro:unless value="$(arg use_ros1_control)">
    <xacro:include filename="gazebo_control.xacro" />
  </xacro:unless>

  <!-- Additional Components -->
  <xacro:include filename="lidar.xacro" />

</robot>
